hdl/boot_build/fsbl_ws/
hdl/boot_build/*.xsa
hdl/boot_build/*.bin
hdl/boot_build/BOOT.BIN.orig
hdl/boot_build/BOOT.BIN.new
hdl/boot_build/.Xil/
hdl/boot_build/vivado.log
hdl/*/vivado.log
hdl/*/vivado_*.backup.jou
hdl/*/vivado_*.backup.log

# Vivado batch-mode session logs written to repo root (when vivado -mode
